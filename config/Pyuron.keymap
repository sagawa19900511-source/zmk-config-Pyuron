#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6
#define AUTO_MOUSE 7
#define LEFT_SCROLL 8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball_listener_L {
    input-processors =
        <&zip_temp_layer AUTO_MOUSE 2000>,
        <&zip_xy_transform
            (INPUT_TRANSFORM_XY_SWAP |
             INPUT_TRANSFORM_X_INVERT)>,
        <&zip_xy_scaler 1 2>;

    left_scroll {
        layers = <LEFT_SCROLL>;
        input-processors =
            <&zip_temp_layer AUTO_MOUSE 2000>,
            <&zip_xy_transform
                (INPUT_TRANSFORM_XY_SWAP |
                 INPUT_TRANSFORM_X_INVERT)>,
            <&zip_xy_scaler 1 16>,
            <&zip_scroll_scaler 1 5>,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&to_layer_0>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 7 Q           &kp W      &kp E      &kp R         &kp T        &kp Y                        &kp U          &kp I        &kp O                         &kp P
&kp A             &kp S      &kp D      &kp F         &kp G        &kp H                        &kp J          &kp K        &kp L                         &kp SQT
&mt LEFT_SHIFT Z  &kp X      &kp C      &kp V         &kp B        &lt 4 LANGUAGE_2             &kp BACKSLASH  &kp N        &kp M                         &kp COMMA
&kp DOT           &kp SLASH  &kp LCTRL  &kp LEFT_WIN  &lt 2 SPACE  &mt LEFT_SHIFT LANG_HANGEUL  &kp BACKSPACE  &lt 1 ENTER  &mt RIGHT_CONTROL LANGUAGE_2  &kp RIGHT_CONTROL
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans   &trans  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans  &trans   &trans  &trans  &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F11  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F12
            >;
        };

        layer_2 {
            bindings = <
&trans         &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW   &kp MINUS  &kp N0     &kp N7        &kp N8   &kp N9        &kp PLUS
&kp LA(GRAVE)  &trans          &kp DOWN_ARROW  &trans            &trans     &kp EQUAL  &kp NUMBER_4  &kp N5   &kp NUMBER_6  &kp MINUS
&trans         &trans          &kp LESS_THAN   &kp GREATER_THAN  &trans     &trans     &trans        &trans   &kp N1        &kp NUMBER_2
&kp NUMBER_3   &kp ASTERISK    &trans          &trans            &trans     &trans     &kp TAB       &kp DEL  &trans        &kp SLASH
            >;
        };

        layer_3 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans   &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans      &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans      &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans      &trans  &trans  &trans  &trans        &bootloader   &trans        &trans        &trans
&trans  &bt BT_CLR  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };

        AUTO_MOUSE {
            bindings = <
&trans  &mkp RCLK  &mo 8      &trans     &trans   &kp LS(LG(NUMBER_4))  &trans  &trans  &trans  &trans
&trans  &trans     &mkp MCLK  &mkp LCLK  &kp ESC  &trans                &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans   &trans                &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans   &trans                &trans  &trans  &trans  &trans
            >;
        };

        LEFT_SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
